# Railway / self-host Crawl4AI for edu-outreach article extract
# Image: https://hub.docker.com/r/unclecode/crawl4ai
FROM unclecode/crawl4ai:latest

ENV HOST=0.0.0.0
ENV PORT=11235

EXPOSE 11235

# Upstream image already starts the API server on 11235.
# Set CRAWL4AI_API_TOKEN in Railway Variables (required in production).
