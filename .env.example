# Supabase (필수)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 사이트맵/SEO (Vercel 빌드 환경에 설정)
# - 빌드 후 dist/sitemap.xml 과 dist/robots.txt 가 생성된다.
# - 또한 승인된 사례 페이지를 정적 prerender 한다 (dist/public/showroom/case/<siteName>/index.html).
# - 비어 있으면 빈 sitemap만 작성하고 prerender는 스킵, 빌드는 통과한다.
#   (STRICT 모드를 켜면 환경변수 누락 시 빌드 실패)
# SITE_PUBLIC_BASE_URL=https://www.findgagu.co.kr
# SITEMAP_STRICT=1
# PRERENDER_STRICT=1
# (Vercel 빌드에서 SITE_PUBLIC_BASE_URL 이 비어 있으면 https://www.findgagu.co.kr 로 기본 적용)

# Vercel Deploy Hook (브라우저에서 호출 → 발행/승인 직후 새 빌드 트리거)
# - Vercel Dashboard > Project > Settings > Git > Deploy Hooks 에서 만든 URL을 그대로 입력.
# - 비어 있으면 트리거가 동작하지 않고 콘솔에만 안내가 남는다 (개발 환경 안전장치).
# - 30초 디바운스가 적용되어 같은 윈도우 안의 다중 호출은 1회로 합쳐진다.
# VITE_VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy

# 보안 원칙:
# - 브라우저에서 읽는 값만 VITE_ 접두사를 사용합니다.
# - API secret, webhook URL, 서비스 토큰, AI 비밀키는 VITE_로 두지 말고 서버사이드 비밀값으로만 관리하세요.

# 데이터 통합 관리 AI 파싱 API (선택, 미설정 시 Mock 사용)
# VITE_MIGRATION_PARSE_API=https://your-api.com/parse

# Edge Function analyze-quote (견적서/원가표 AI 분석) — Supabase Secrets에 설정
# supabase secrets set GOOGLE_GEMINI_API_KEY=AIza...
# 선택: GOOGLE_GEMINI_MODEL=gemini-3.5-flash  (2.0-flash는 종료됨)
# 광고 대기실 이미지 편집(사람 제거/Before 합성) — Vercel env (미설정 시 gemini-3.1-flash-image)
# GOOGLE_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 더 강한 지시 준수가 필요하면: gemini-3-pro-image

# 사례 블로그 예약 공개 스케줄러 (Edge + pg_cron)
# node scripts/setupShowroomCaseBlogPublishSchedulerCron.mjs
# supabase secrets set SHOWROOM_CASE_BLOG_PUBLISH_CRON_SECRET=...
# 선택: VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# 채널톡 웹훅 (Edge Function 시크릿 — Supabase 대시보드 > Edge Functions > channel-talk-webhook > Secrets에서 설정)
# VITE_CHANNEL_TALK_PLUGIN_KEY=your-channel-plugin-key
# CHANNELTALK_WEBHOOK_SECRET=your-webhook-sign-secret
# CHANNELTALK_ACCESS_KEY=your-channel-talk-access-key
# CHANNELTALK_ACCESS_SECRET=your-channel-talk-access-secret
# CHANNELTALK_BOT_NAME=your-channel-bot-name
# SHOWROOM_PUBLIC_BASE_URL=https://findgagu-os-cursor.vercel.app/public/showroom
# (채널톡 자동 메시지의 링크 — 로그인 없이 열리는 맞춤형 공개 쇼룸)
# 선택: SHOWROOM_PREVIEW_SITE_LIMIT=6 (Edge에서 먼저 보여 줄 현장 수, 1–50)
# 웹훅 URL: https://<project-ref>.supabase.co/functions/v1/channel-talk-webhook

# 쇼룸 숏츠 자동화 (서버사이드 전용 — Supabase Secrets)
# 배포:
# npx supabase functions deploy showroom-shorts-create --no-verify-jwt
# npx supabase functions deploy showroom-shorts-poll --no-verify-jwt
# npx supabase functions deploy showroom-shorts-publish-dispatch
# npx supabase functions deploy showroom-shorts-publish-callback --no-verify-jwt
# KLING_ACCESS_KEY=your-kling-access-key
# KLING_SECRET_KEY=your-kling-secret-key
# KLING_API_BASE_URL=https://api.klingai.com
# KLING_MODEL_NAME=kling-v3
# 선택: KLING_MODEL_NAME에 omni 계열 값을 넣으면 /v1/videos/omni 경로를 사용합니다.
# SHOWROOM_SHORTS_CALLBACK_URL=https://<project-ref>.supabase.co/functions/v1/showroom-shorts-callback
# SHOWROOM_SHORTS_PUBLISH_WEBHOOK_URL=https://your-n8n-host/webhook/showroom-shorts-publish
# SHOWROOM_SHORTS_PUBLISH_WEBHOOK_SECRET=your-showroom-shorts-n8n-secret
# SHOWROOM_SHORTS_PUBLISH_MODE=live
# SHOWROOM_SHORTS_PUBLISH_CALLBACK_URL=https://<project-ref>.supabase.co/functions/v1/showroom-shorts-publish-callback
# SHOWROOM_SHORTS_PUBLISH_CALLBACK_SECRET=your-showroom-shorts-callback-secret
# Slack Incoming Webhook — 발행 failed / publishing·preparing 고임 알람 (Edge secret)
# SHOWROOM_SHORTS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# 쇼룸 숏츠 Railway 워커
# 브라우저는 기본적으로 같은 도메인의 /api/showroom-shorts-worker 프록시를 사용합니다.
# Vercel 서버 환경 변수:
# SHOWROOM_SHORTS_WORKER_URL=https://your-railway-worker.up.railway.app
# SHOWROOM_SHORTS_WORKER_TOKEN=your-worker-shared-secret
# 워커(Railway) 환경 변수:
# SHOWROOM_SHORTS_BGM_URL=https://your-cdn.example.com/bright-lines-new-light-sample-b-24-34.mp3
# SHOWROOM_SHORTS_FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# 선택: 브라우저에서 프록시가 아닌 다른 URL을 강제로 쓰려면 VITE_SHOWROOM_SHORTS_WORKER_URL 설정

# 로컬 Vite 개발 서버에서 /api/showroom-shorts-worker 를 어디로 프록시할지 지정
# 기본값은 현재 운영 Vercel 프록시
# SHOWROOM_SHORTS_PROXY_TARGET=https://findgagu-os-cursor.vercel.app
# 필요하면 Railway 직결도 가능
# SHOWROOM_SHORTS_PROXY_TOKEN=your-worker-token-if-calling-railway-directly

# 콘텐츠 자동화 디스패치 (서버사이드 전용 — content-automation-dispatch Edge Function Secrets)
# 배포: npx supabase functions deploy content-automation-dispatch
# 기본 fallback
# CONTENT_AUTOMATION_DEFAULT_WEBHOOK_URL=https://your-n8n-or-worker/webhook/content
# CONTENT_AUTOMATION_DEFAULT_WEBHOOK_SECRET=your-shared-secret
# CONTENT_AUTOMATION_DEFAULT_MODE=mock
# CONTENT_AUTOMATION_DEFAULT_LABEL=Default Dispatch
#
# 채널별 override 예시
# CONTENT_AUTOMATION_GOOGLE_BLOG_WEBHOOK_URL=https://your-n8n/webhook/google-blog
# VITE_CONTENT_AUTOMATION_GOOGLE_BLOG_WEBHOOK_URL=https://your-n8n/webhook/google-blog
# CONTENT_AUTOMATION_GOOGLE_BLOG_WEBHOOK_SECRET=your-google-blog-secret
# CONTENT_AUTOMATION_GOOGLE_BLOG_MODE=live
# CONTENT_AUTOMATION_GOOGLE_BLOG_LABEL=Google Blog
#
# 쇼룸 케이스 콘텐츠 작업실 → 서버 프록시 → n8n 웹훅
# Vercel 서버 환경변수 / Supabase Secrets처럼 서버에서만 읽는 곳에 설정하세요.
# 브라우저에 노출되는 VITE_ 접두사를 사용하면 안 됩니다.
# SHOWROOM_CASE_CONTENT_WEBHOOK_URL=https://your-n8n-host/webhook/findgagu-showroom-case-content-generate
# SHOWROOM_CASE_CONTENT_WEBHOOK_SECRET=your-shared-secret
# 선택: 쉼표로 허용 이메일 제한
# SHOWROOM_CASE_CONTENT_ALLOWED_EMAILS=admin@findgagu.com
#
# CONTENT_AUTOMATION_NAVER_BLOG_WEBHOOK_URL=https://your-n8n/webhook/naver-blog
# CONTENT_AUTOMATION_NAVER_BLOG_MODE=mock

# 교육가구 아웃리치 — 네이버 검색 API (BefoAftr 인테리어 업체 검색과 동일 키)
# 개발자센터 앱에서 "검색 > 뉴스" + "검색 > 지역" 사용 설정 필요
# 서버(Vercel) 환경변수만 사용. VITE_NAVER_* 는 금지(클라이언트 번들 노출).
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
#
# 내부 관리자 추가 이메일(쉼표). 기본은 *@findgagu.com 허용.
# INTERNAL_ADMIN_ALLOWED_EMAILS=ops@example.com
# EDU_OUTREACH_ALLOWED_EMAILS=
# 프론트 가드용(시크릿 아님). API/RLS와 맞추려면 동일 이메일 추가.
# VITE_INTERNAL_ADMIN_ALLOWED_EMAILS=ops@example.com

# 교육가구 아웃리치 — 본문 추출 엔진
# 우선순위: Crawl4AI → Scrapling → Readability
# 로컬 Docker: scripts/start-crawl4ai.sh / docker-compose.crawl4ai.yml
# CRAWL4AI_BASE_URL=http://127.0.0.1:11235
# 프로덕션(Vercel): Railway Crawl4AI (crawl4ai/ + docs/RAILWAY_CRAWL4AI_DEPLOY_CHECKLIST.md)
# CRAWL4AI_BASE_URL=https://<crawl4ai-service>.up.railway.app
# CRAWL4AI_API_TOKEN=  # Railway Variables와 동일 (업무참고용/.secrets/crawl4ai_api_token)
# Scrapling은 로컬 전용 (Vercel 불가)
# SCRAPLING_PYTHON=/Users/findgagu/Desktop/업무참고용/.venvs/scrapling/bin/python
# EDU_OUTREACH_EXTRACT_SCRIPT=scripts/edu_outreach_extract_article.py
#
# CONTENT_AUTOMATION_INSTAGRAM_WEBHOOK_URL=https://your-n8n/webhook/instagram
# CONTENT_AUTOMATION_YOUTUBE_SHORTS_WEBHOOK_URL=https://your-n8n/webhook/youtube-shorts
# CONTENT_AUTOMATION_FACEBOOK_CARDNEWS_WEBHOOK_URL=https://your-n8n/webhook/facebook-cardnews
#
# 외부 자동화 -> Supabase callback
# 배포: npx supabase functions deploy content-automation-callback --no-verify-jwt
# CONTENT_AUTOMATION_CALLBACK_SECRET=your-callback-secret

# 경쟁사 모니터링 (YouTube Data API — Edge Function 시크릿, FINDGAGU 전용)
# 발급: docs/COMPETITOR_MONITOR_SETUP.md
# 등록: node scripts/setupYoutubeDataApiKey.mjs AIzaSy...
# YOUTUBE_DATA_API_KEY=your-findgagu-youtube-data-api-key

# YouTube Analytics OAuth (FINDGAGU 채널 쇼츠 지표 — Vercel API 시크릿)
# 설정: docs/YOUTUBE_ANALYTICS_OAUTH_SETUP.md
# GOOGLE_YT_ANALYTICS_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_YT_ANALYTICS_CLIENT_SECRET=
# GOOGLE_YT_ANALYTICS_REDIRECT_URI=https://findgagu-os-cursor.vercel.app/api/youtube-analytics-oauth-callback
# YOUTUBE_ANALYTICS_TOKEN_ENC_KEY=   # openssl rand -hex 32
# SUPABASE_SERVICE_ROLE_KEY=         # oauth/analytics 테이블 쓰기 (VITE_ 금지)

# 경쟁사 인스타 수집 (Apify — Edge Function 시크릿)
# 토큰: https://console.apify.com/account/integrations
# node scripts/setupApifyToken.mjs apify_api_...
# APIFY_API_TOKEN=apify_api_...

# 구글 시트 양방향 동기화는 서버사이드에서 호출하세요.
# Apps Script 토큰은 브라우저 환경변수에 두면 안 됩니다.
# VITE_GOOGLE_SHEET_SYNC_URL=https://script.google.com/macros/s/xxxxxxxx/exec
